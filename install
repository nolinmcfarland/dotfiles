#!/bin/bash

DOT=$HOME/dotfiles
CONFIG=$HOME/.config

set -e

step() {
    printf '\033[1;34m→\033[0m \033[1m%s...\033[0m\n' "$1"
}

trap 'printf "\033[1;31m→ Failed\033[0m\n"' ERR

step "Symlinking dotfiles"

mkdir -p "$CONFIG"
ln -sf "$DOT/ghostty" "$CONFIG"
ln -sf "$DOT/nvim" "$CONFIG"
ln -sf "$DOT/starship/starship.toml" "$CONFIG/starship.toml"

ln -sf "$DOT/zsh/zshrc" "$HOME/.zshrc"
ln -sf "$DOT/git/gitconfig" "$HOME/.gitconfig"
ln -sf "$DOT/git/gitignore" "$HOME/.gitignore"
touch "$HOME/.hushlogin"

step "Installing Homebrew"

if ! command -v brew &> /dev/null; then
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    echo 'eval "$(/opt/homebrew/bin/brew shellenv)"' >> ~/.zprofile
    eval "$(/opt/homebrew/bin/brew shellenv)"
else
    brew update -q
fi

step "Installing packages"

brew bundle install --file "$DOT/Brewfile" --no-upgrade
go install golang.org/x/tools/cmd/goimports@v0.49.0
brew pin go gopls lua-language-server neovim ripgrep starship tree-sitter-cli

step "Restoring Neovim plugins"

nvim --headless '+Lazy! restore' +qa
nvim --headless '+Lazy! clean' +qa
nvim --headless "+lua require('nvim-treesitter').install({ 'go', 'lua' }):wait()" +qa

printf '\033[1;32m→ Done\033[0m\n'
